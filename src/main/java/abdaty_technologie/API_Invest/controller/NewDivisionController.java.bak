package abdaty_technologie.API_Invest.controller;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpMethod;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.client.RestTemplate;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Nouveau contrôleur pour les divisions administratives
 * Compatible avec l'ancienne API mais utilise l'API INSTAT Mali
 * Remplace progressivement l'ancien DivisionController
 */
@RestController
@RequestMapping("/divisions")
@CrossOrigin(origins = "*")
public class NewDivisionController {
    
    private static final String INSTAT_BASE_URL = "https://apimali.test.instat.ml/api";
    private static final String BEARER_TOKEN = "MTI1OTEyNjkxNDQ5MTIzOTE0NDkxMDc5MTA2OTEzMDkxMTY5MTA0OTEzMjkxMjY5MTI2OTE1NTkxMjI5MTI0OTEzMjkxMDU5MTQ0OTEwNzkxMjc5MTA1OTY1OTEwNTkxMTU5MTA0OTYw";
    
    /**
     * Créer les headers pour l'API INSTAT
     */
    private HttpHeaders createHeaders() {
        HttpHeaders headers = new HttpHeaders();
        headers.set("Authorization", "Bearer " + BEARER_TOKEN);
        headers.set("accept", "*/*");
        headers.set("X-CSRF-TOKEN", "");
        return headers;
    }
    
    /**
     * Récupérer toutes les régions
     * Compatible avec l'ancienne API : GET /divisions/regions
     */
    @GetMapping("/regions")
    public ResponseEntity<List<Map<String, Object>>> getAllRegions() {
        try {
            System.out.println("[NewDivisionController] Récupération de toutes les régions via INSTAT API");
            
            RestTemplate restTemplate = new RestTemplate();
            HttpEntity<?> entity = new HttpEntity<>(createHeaders());
            
            ResponseEntity<List> response = restTemplate.exchange(
                INSTAT_BASE_URL + "/get/regions",
                HttpMethod.GET,
                entity,
                List.class
            );
            
            List<Map<String, Object>> regions = (List<Map<String, Object>>) response.getBody();
            if (regions != null && !regions.isEmpty()) {
                // Transformer en format compatible
                List<Map<String, Object>> result = new ArrayList<>();
                for (Map<String, Object> region : regions) {
                    Map<String, Object> transformed = Map.of(
                        "id", region.getOrDefault("code_region", ""),
                        "code", region.getOrDefault("code_region", ""),
                        "nom", region.getOrDefault("nom_region", ""),
                        "libelle", region.getOrDefault("nom_region", ""),
                        "type", "REGION"
                    );
                    result.add(transformed);
                }
                
                System.out.println("[NewDivisionController] " + result.size() + " régions récupérées");
                return ResponseEntity.ok(result);
            }
            
            return ResponseEntity.ok(new ArrayList<>());
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors de la récupération des régions: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(new ArrayList<>());
        }
    }
    
    /**
     * Récupérer les cercles d'une région
     * Compatible avec l'ancienne API : GET /divisions/regions/{regionId}/cercles
     * Note: regionId est maintenant le code de la région
     */
    @GetMapping("/regions/{regionCode}/cercles")
    public ResponseEntity<List<DivisionDto>> getCerclesByRegion(@PathVariable String regionCode) {
        try {
            System.out.println("[NewDivisionController] Récupération des cercles pour la région: " + regionCode);
            List<CercleResponse> cercles = instatApiService.getCerclesByRegion(regionCode);
            List<DivisionDto> cerclesDto = mappingService.mapCerclesToDto(cercles);
            System.out.println("[NewDivisionController] " + cerclesDto.size() + " cercles récupérés");
            return ResponseEntity.ok(cerclesDto);
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors de la récupération des cercles: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(new ArrayList<>());
        }
    }
    
    /**
     * Récupérer les communes d'un cercle
     * Compatible avec l'ancienne API : GET /divisions/cercles/{cercleId}/communes
     * Note: cercleId est maintenant le code du cercle
     */
    @GetMapping("/cercles/{cercleCode}/communes")
    public ResponseEntity<List<DivisionDto>> getCommunesByCercle(@PathVariable String cercleCode) {
        try {
            System.out.println("[NewDivisionController] Récupération des communes pour le cercle: " + cercleCode);
            List<CommuneResponse> communes = instatApiService.getCommunesByCercle(cercleCode);
            List<DivisionDto> communesDto = mappingService.mapCommunesToDto(communes);
            System.out.println("[NewDivisionController] " + communesDto.size() + " communes récupérées");
            return ResponseEntity.ok(communesDto);
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors de la récupération des communes: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(new ArrayList<>());
        }
    }
    
    /**
     * Récupérer les quartiers d'une commune
     * Compatible avec l'ancienne API : GET /divisions/communes/{communeId}/quartiers
     * Note: communeId est maintenant le code de la commune
     */
    @GetMapping("/communes/{communeCode}/quartiers")
    public ResponseEntity<List<DivisionDto>> getQuartiersByCommune(@PathVariable String communeCode) {
        try {
            System.out.println("[NewDivisionController] Récupération des quartiers pour la commune: " + communeCode);
            List<QuartierResponse> quartiers = instatApiService.getQuartiersByCommune(communeCode);
            List<DivisionDto> quartiersDto = mappingService.mapQuartiersToDto(quartiers);
            System.out.println("[NewDivisionController] " + quartiersDto.size() + " quartiers récupérés");
            return ResponseEntity.ok(quartiersDto);
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors de la récupération des quartiers: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(new ArrayList<>());
        }
    }
    
    /**
     * Recherche rapide de divisions par nom
     * Compatible avec l'ancienne API : GET /divisions/search?query=...&type=...
     */
    @GetMapping("/search")
    public ResponseEntity<List<DivisionDto>> searchDivisions(
            @RequestParam String query,
            @RequestParam(required = false) String type) {
        
        try {
            System.out.println("[NewDivisionController] Recherche divisions: query=" + query + ", type=" + type);
            
            if (query == null || query.trim().length() < 2) {
                return ResponseEntity.ok(new ArrayList<>());
            }
            
            List<DivisionDto> results = new ArrayList<>();
            String lowerQuery = query.toLowerCase().trim();
            
            // Rechercher dans les régions
            if (type == null || type.equalsIgnoreCase("REGION")) {
                List<RegionResponse> regions = instatApiService.getAllRegions();
                for (RegionResponse region : regions) {
                    if (region.getNom() != null && region.getNom().toLowerCase().contains(lowerQuery)) {
                        results.add(mappingService.mapRegionToDto(region));
                    }
                }
            }
            
            // Rechercher dans les cercles (limité aux premières régions)
            if (type == null || type.equalsIgnoreCase("CERCLE")) {
                List<RegionResponse> regions = instatApiService.getAllRegions();
                for (RegionResponse region : regions.stream().limit(5).toList()) {
                    List<CercleResponse> cercles = instatApiService.getCerclesByRegion(region.getCode());
                    for (CercleResponse cercle : cercles) {
                        if (cercle.getNom() != null && cercle.getNom().toLowerCase().contains(lowerQuery)) {
                            results.add(mappingService.mapCercleToDto(cercle));
                        }
                    }
                }
            }
            
            // Rechercher dans les communes (limité)
            if (type == null || type.equalsIgnoreCase("COMMUNE")) {
                List<RegionResponse> regions = instatApiService.getAllRegions();
                for (RegionResponse region : regions.stream().limit(3).toList()) {
                    List<CercleResponse> cercles = instatApiService.getCerclesByRegion(region.getCode());
                    for (CercleResponse cercle : cercles.stream().limit(3).toList()) {
                        List<CommuneResponse> communes = instatApiService.getCommunesByCercle(cercle.getCode());
                        for (CommuneResponse commune : communes) {
                            if (commune.getNom() != null && commune.getNom().toLowerCase().contains(lowerQuery)) {
                                results.add(mappingService.mapCommuneToDto(commune));
                            }
                        }
                    }
                }
            }
            
            // Rechercher dans les quartiers (très limité)
            if (type != null && type.equalsIgnoreCase("QUARTIER")) {
                List<RegionResponse> regions = instatApiService.getAllRegions();
                for (RegionResponse region : regions.stream().limit(2).toList()) {
                    List<CercleResponse> cercles = instatApiService.getCerclesByRegion(region.getCode());
                    for (CercleResponse cercle : cercles.stream().limit(2).toList()) {
                        List<CommuneResponse> communes = instatApiService.getCommunesByCercle(cercle.getCode());
                        for (CommuneResponse commune : communes.stream().limit(2).toList()) {
                            List<QuartierResponse> quartiers = instatApiService.getQuartiersByCommune(commune.getCode());
                            for (QuartierResponse quartier : quartiers) {
                                if (quartier.getNom() != null && quartier.getNom().toLowerCase().contains(lowerQuery)) {
                                    results.add(mappingService.mapQuartierToDto(quartier));
                                }
                            }
                        }
                    }
                }
            }
            
            // Limiter les résultats à 20
            if (results.size() > 20) {
                results = results.subList(0, 20);
            }
            
            System.out.println("[NewDivisionController] " + results.size() + " résultats trouvés");
            return ResponseEntity.ok(results);
            
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors de la recherche: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(new ArrayList<>());
        }
    }
    
    /**
     * Récupérer une division par son code
     * Compatible avec l'ancienne API : GET /divisions/code/{code}
     */
    @GetMapping("/code/{code}")
    public ResponseEntity<DivisionDto> getDivisionByCode(@PathVariable String code) {
        try {
            System.out.println("[NewDivisionController] Recherche division par code: " + code);
            
            if (code == null || code.trim().isEmpty()) {
                return ResponseEntity.notFound().build();
            }
            
            // Essayer de trouver dans les régions
            List<RegionResponse> regions = instatApiService.getAllRegions();
            for (RegionResponse region : regions) {
                if (code.equals(region.getCode())) {
                    return ResponseEntity.ok(mappingService.mapRegionToDto(region));
                }
            }
            
            // Essayer de trouver dans les cercles
            for (RegionResponse region : regions) {
                List<CercleResponse> cercles = instatApiService.getCerclesByRegion(region.getCode());
                for (CercleResponse cercle : cercles) {
                    if (code.equals(cercle.getCode())) {
                        return ResponseEntity.ok(mappingService.mapCercleToDto(cercle));
                    }
                }
            }
            
            // Essayer de trouver dans les communes (limité)
            for (RegionResponse region : regions.stream().limit(5).toList()) {
                List<CercleResponse> cercles = instatApiService.getCerclesByRegion(region.getCode());
                for (CercleResponse cercle : cercles.stream().limit(5).toList()) {
                    List<CommuneResponse> communes = instatApiService.getCommunesByCercle(cercle.getCode());
                    for (CommuneResponse commune : communes) {
                        if (code.equals(commune.getCode())) {
                            return ResponseEntity.ok(mappingService.mapCommuneToDto(commune));
                        }
                    }
                }
            }
            
            System.out.println("[NewDivisionController] Division non trouvée pour le code: " + code);
            return ResponseEntity.notFound().build();
            
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors de la recherche par code: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
        }
    }
    
    /**
     * Compter le nombre total de divisions (approximatif)
     * Compatible avec l'ancienne API : GET /divisions/count
     */
    @GetMapping("/count")
    public ResponseEntity<Long> countDivisions() {
        try {
            System.out.println("[NewDivisionController] Comptage approximatif des divisions");
            
            List<RegionResponse> regions = instatApiService.getAllRegions();
            long count = regions.size();
            
            // Compter quelques cercles pour estimation
            for (RegionResponse region : regions.stream().limit(3).toList()) {
                List<CercleResponse> cercles = instatApiService.getCerclesByRegion(region.getCode());
                count += cercles.size();
            }
            
            System.out.println("[NewDivisionController] Estimation du nombre de divisions: " + count);
            return ResponseEntity.ok(count);
            
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur lors du comptage: " + e.getMessage());
            return ResponseEntity.ok(0L);
        }
    }
    
    /**
     * Test de connectivité
     * GET /divisions/test
     */
    @GetMapping("/test")
    public ResponseEntity<String> testConnection() {
        try {
            System.out.println("[NewDivisionController] Test de connectivité avec l'API INSTAT");
            List<RegionResponse> regions = instatApiService.getAllRegions();
            
            if (regions.isEmpty()) {
                return ResponseEntity.ok("Connexion établie mais aucune région récupérée");
            }
            
            return ResponseEntity.ok("Connexion réussie - " + regions.size() + " régions disponibles via INSTAT API");
        } catch (Exception e) {
            System.err.println("[NewDivisionController] Erreur de connectivité: " + e.getMessage());
            return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
                    .body("Erreur de connexion à l'API INSTAT: " + e.getMessage());
        }
    }
}
