# Configuration exemple pour API-Invest
# Copier ce fichier vers application.yml et ajuster selon votre environnement

server:
  port: 8080

# Configuration CORS - IMPORTANT pour les applications déployées
app:
  cors:
    allowed-origins: >
      https://investmali.abdatytch.com,
      https://investmali-agent.abdatytch.com

# Configuration Base de données
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/investmali_db
    username: your_username
    password: your_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect
        format_sql: true

# Configuration JWT
jwt:
  secret: your-jwt-secret-key-here
  expiration: 86400000 # 24 heures en millisecondes

# Configuration Stripe (si utilisé)
stripe:
  public-key: pk_test_your_stripe_public_key
  secret-key: sk_test_your_stripe_secret_key

# Configuration de logging
logging:
  level:
    abdaty_technologie.API_Invest: INFO
    org.springframework.security: DEBUG
    org.springframework.web.cors: DEBUG
