# Configuration API pour l'application Utilisateur InvestMali
# Copier ce fichier vers .env et ajuster les valeurs selon votre environnement

# URL de base de l'API backend Spring Boot
REACT_APP_USER_API_URL=http://localhost:8080/api/v1

# Port de l'application React User (optionnel, par défaut 3000)
PORT=3000

# Environnement de développement
NODE_ENV=development

# Timeout pour les requêtes API (en millisecondes)
REACT_APP_API_TIMEOUT=30000

# Activer les logs de debug pour les appels API (true/false)
REACT_APP_DEBUG_API=true

# Configuration pour différents environnements
# Développement local
# REACT_APP_USER_API_URL=http://localhost:8080/api/v1

# Environnement de test
# REACT_APP_USER_API_URL=http://localhost:3001/api/v1

# Production
# REACT_APP_USER_API_URL=https://api.investmali.ml/api/v1
# REACT_APP_DEBUG_API=false
# REACT_APP_API_TIMEOUT=60000
