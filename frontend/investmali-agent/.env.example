# Configuration API pour l'application Agent InvestMali
# Copier ce fichier vers .env et ajuster les valeurs selon votre environnement

# URL de base de l'API backend Spring Boot
REACT_APP_USER_API_URL=http://localhost:8080/api/v1

# Port de l'application React Agent (optionnel, par défaut 3001)
PORT=3001

# Environnement de développement
NODE_ENV=development

# Configuration optionnelle pour les endpoints de création d'application
# Utilisé par createApplicationForClientMultipartSmart pour tester plusieurs chemins
REACT_APP_CREATE_CLIENT_APP_PATH=/agent/applications,/applications

# Timeout pour les requêtes API (en millisecondes)
REACT_APP_API_TIMEOUT=30000

# Activer les logs de debug pour les appels API (true/false)
REACT_APP_DEBUG_API=true
